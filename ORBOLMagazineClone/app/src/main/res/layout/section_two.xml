<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingVertical="45dp"
    android:paddingHorizontal="20dp">

    <ImageView
        android:id="@+id/featured_image_view"
        android:layout_width="match_parent"
        android:layout_height="374dp" />

    <TextView
        android:id="@+id/featured_title"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="20dp"
        android:textSize="36sp"
        android:textColor="@color/bg_dark"
        android:fontFamily="@font/varent"/>

    <TextView
        android:id="@+id/featured_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="20sp"
        android:textColor="@color/bg_dark"
        android:fontFamily="@font/brown"/>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/save_icon"
        app:tint="@color/bg_dark" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_featured"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/read_more"
        android:textColor="@color/bg_dark"
        android:fontFamily="@font/grotesk"
        android:textAllCaps="false"
        android:paddingRight="60dp"
        android:paddingLeft="10dp"
        android:layout_marginTop="53dp"
        android:background="@drawable/button_background_black"/>

</LinearLayout>